<!DOCTYPE html>
<html>
<head>
    <title>Conference Schedule</title>
</head>
<body>

    <header>
        <h1>Technology Conference 2026</h1>
    </header>

    <table border="1">

        <caption>
            <strong>Conference Schedule</strong>
        </caption>

        <!-- Table header -->
        <thead>
            <tr>
                <th>Session</th>
                <th>Time</th>
                <th>Topic</th>
                <th>Speaker</th>
            </tr>
        </thead>

        <!-- Table body -->
        <tbody>

            <tr>
                <td>Morning</td>
                <td>9:00 AM</td>
                <td>Artificial Intelligence</td>
                <td>Dr. Sharma</td>
            </tr>

            <tr>
                <td>Morning</td>
                <td>11:00 AM</td>
                <td>Machine Learning</td>
                <td>Ms. Singh</td>
            </tr>

            <tr>
                <td>Afternoon</td>
                <td>2:00 PM</td>
                <td>Data Science</td>
                <td>Mr. Verma</td>
            </tr>

            <tr>
                <td>Evening</td>
                <td>5:00 PM</td>
                <td>Future of Technology</td>
                <td>Dr. Kumar</td>
            </tr>

        </tbody>

        <!-- Table footer -->
        <tfoot>
            <tr>
                <td colspan="4">
                    Conference ends at 6:00 PM
                </td>
            </tr>
        </tfoot>

    </table>

</body>
</html>